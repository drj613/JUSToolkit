+bool MainWindow::openLuaScriptFile(const QString& path)
+{
+    QFileInfo file(QFileInfo(path).absoluteFilePath());
+    if (!file.exists() || !file.isFile())
+    {
+        printf("--lua-script: no such file: %s\n", path.toLocal8Bit().constData());
+        return false;
+    }
+
+    onOpenLuaScript();//creates/shows the console dialog
+    if (!luaDialog) return false;
+
+    luaDialog->currentScript = file;
+    luaDialog->getLuaBundle()->flagNewLua = true;//picked up on the next signalLuaUpdate
+    return true;
+}
