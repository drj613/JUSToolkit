+	// The bytes were read into the TOP of the s64, so on a little-endian host
+	// `value` is the real value shifted left by the unused byte count. Shift it
+	// back down: arithmetic for signed types (sign-extends), logical otherwise.
+	constexpr int unusedBits = (int)((sizeof(s64) - sizeof(T)) * 8);
+	if (dummyIntType::isSigned<T>) value = value >> unusedBits;
+	else value = (s64)((u64)value >> unusedBits);
     lua_pushinteger(L, value);
