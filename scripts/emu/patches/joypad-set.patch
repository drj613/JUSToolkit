diff --git a/src/frontend/qt_sdl/lua/libs/LuaInput.cpp b/src/frontend/qt_sdl/lua/libs/LuaInput.cpp
index 48567397..544b9899 100644
--- a/src/frontend/qt_sdl/lua/libs/LuaInput.cpp
+++ b/src/frontend/qt_sdl/lua/libs/LuaInput.cpp
@@ -125,4 +125,54 @@ namespace luaJoypadDefinitions
 
 AddJoypadFunction(luaInputDefinitions::Lua_getJoy,get);//aliase for input.getjoy
 
+//Buttons in order of the core key mask.
+static const char* joyOrder[12] =
+{
+    "A","B","Select","Start",
+    "Right","Left","Up","Down",
+    "R","L","X","Y"
+};
+
+// joypad.set(table|nil)
+//   table -> override active; the table is the complete pressed set,
+//            physical input is ignored. {} = force-neutral.
+//   nil   -> release: override off, physical input returns.
+int Lua_setJoy(lua_State* L)
+{
+    LuaBundle* bundle = get_bundle(L);
+    EmuInstance* inst = bundle->getEmuInstance();
+    if (lua_isnoneornil(L,1))
+    {
+        inst->clearLuaInputOverride();
+        return 0;
+    }
+    luaL_checktype(L,1,LUA_TTABLE);
+    uint32_t mask = 0xFFF;//all released (active low)
+    for (int i = 0; i < 12; i++)
+    {
+        lua_getfield(L,1,joyOrder[i]);
+        if (lua_toboolean(L,-1)) mask &= ~(1u << i);
+        lua_pop(L,1);
+    }
+    inst->luaInputMask.store(mask, std::memory_order_relaxed);
+    inst->luaInputOverride.store(true, std::memory_order_relaxed);
+    return 0;
+}
+AddJoypadFunction(Lua_setJoy,set);
+
+// joypad.get_committed() -> table of the mask actually handed to the core
+int Lua_getCommitted(lua_State* L)
+{
+    LuaBundle* bundle = get_bundle(L);
+    uint32_t mask = bundle->getEmuInstance()->lastCommittedMask.load(std::memory_order_relaxed);
+    lua_createtable(L,0,12);
+    for (int i = 0; i < 12; i++)
+    {
+        lua_pushboolean(L, !(mask & (1u << i)));//active low -> pressed
+        lua_setfield(L,-2,joyOrder[i]);
+    }
+    return 1;
+}
+AddJoypadFunction(Lua_getCommitted,get_committed);
+
 }
