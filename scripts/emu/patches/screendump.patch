+// Headless screen capture for Lua scripts.
+//
+// WHY THIS EXISTS. The agent harness verifies menu navigation by looking at the
+// screen, and was doing that with macOS `screencapture -l <windowid>`. That has
+// two problems, one fatal:
+//
+//   1. It requires the melonDS window to be frontmost, because screencapture on
+//      an OCCLUDED window returns a STALE cached backing store. Measured: the
+//      bridge advanced 130 frames in 2 seconds and 13,520 bytes of main RAM
+//      changed, while every capture came back byte-identical and no button or tap
+//      appeared to do anything. That is the worst kind of silent failure.
+//   2. Bringing the window forward steals the user's keyboard focus, which makes
+//      the machine unusable while a long scripted run is going.
+//
+// Reading the framebuffer from inside the core fixes both: no window, no focus,
+// no compositor involvement, and it works when the window is buried.
+//
+// Writes a binary PPM (P6) 256x384 with the top screen above the bottom screen,
+// matching the physical DS layout. PPM because it needs no library and every
+// image tool reads it.
+//
+// Caveat worth knowing: GetFramebuffers only succeeds for renderers that keep
+// framebuffers in RAM. Under the OpenGL renderer it returns false, and this
+// function returns false rather than writing a misleading file -- switch melonDS
+// to the software renderer in that case.
+#include "lua/LuaMain.h"
+#include "NDS.h"
+#include <cstdio>
+#include <cstring>
+
+std::vector<luaL_Reg> screenFunctions;
+LuaLibrary screenLibrary("screen", &screenFunctions);
+
+namespace luaScreenDefinitions
+{
+#define AddScreenFunction(functPointer,name)LuaFunctionRegister name(functPointer,#name,&screenFunctions)
+
+static const int SCR_W = 256;
+static const int SCR_H = 192;
+
+// dump(path) -> true on success, false + message otherwise
+int Lua_dump(lua_State* L)
+{
+    const char* path = luaL_checkstring(L, 1);
+    LuaBundle* bundle = get_bundle(L);
+    auto emuInstance = bundle->getEmuInstance();
+    if (!emuInstance) { lua_pushboolean(L,0); lua_pushstring(L,"no emu instance"); return 2; }
+    auto nds = emuInstance->getNDS();
+    if (!nds) { lua_pushboolean(L,0); lua_pushstring(L,"no NDS"); return 2; }
+
+    void* top = nullptr; void* bottom = nullptr;
+    if (!nds->GPU.GetFramebuffers(&top, &bottom) || !top || !bottom)
+    {
+        lua_pushboolean(L,0);
+        lua_pushstring(L,"renderer does not expose RAM framebuffers (OpenGL?) -- "
+                         "switch to the software renderer");
+        return 2;
+    }
+
+    FILE* f = fopen(path, "wb");
+    if (!f) { lua_pushboolean(L,0); lua_pushstring(L,"cannot open output file"); return 2; }
+    fprintf(f, "P6\n%d %d\n255\n", SCR_W, SCR_H * 2);
+
+    // Framebuffers are 32-bit pixels. melonDS's own Qt path memcpy's them
+    // straight into a QImage::Format_RGB32, which on a little-endian host is
+    // B,G,R,X in memory -- so swap to R,G,B for PPM.
+    const unsigned char* planes[2] = {
+        static_cast<const unsigned char*>(top),
+        static_cast<const unsigned char*>(bottom)
+    };
+    unsigned char row[SCR_W * 3];
+    for (int p = 0; p < 2; p++)
+    {
+        for (int y = 0; y < SCR_H; y++)
+        {
+            const unsigned char* src = planes[p] + (size_t)y * SCR_W * 4;
+            for (int x = 0; x < SCR_W; x++)
+            {
+                row[x*3+0] = src[x*4+2];
+                row[x*3+1] = src[x*4+1];
+                row[x*3+2] = src[x*4+0];
+            }
+            fwrite(row, 1, sizeof row, f);
+        }
+    }
+    fclose(f);
+    lua_pushboolean(L,1);
+    return 1;
+}
+AddScreenFunction(Lua_dump,dump);
+}
