+// ---- JUS write-watchpoint hook (local RE instrumentation, not upstreamable) ----
+// Set JUS_WATCH to comma-separated hex ARM9 addresses, e.g.
+//   JUS_WATCH=0x020AFEB8,0x02112172
+// Optional: JUS_WATCH_LOG=/path/to/file (default: stderr).
+// INTERPRETER ONLY: the JIT bypasses ARMv5::DataWrite*, so disable JIT
+// (Emu settings -> CPU emulation -> uncheck "Enable JIT recompiler").
+// Cost when JUS_WATCH is unset: one empty-vector check per write.
+static inline void JusWatchCheck(u32 addr, u32 val, int size, const u32* R)
+{
+    static std::vector<u32> watch = []{
+        std::vector<u32> v;
+        if (const char* env = getenv("JUS_WATCH")) {
+            char* s = strdup(env);
+            for (char* tok = strtok(s, ", "); tok; tok = strtok(nullptr, ", "))
+                v.push_back((u32)strtoul(tok, nullptr, 16));
+            free(s);
+        }
+        return v;
+    }();
+    if (watch.empty()) return;
+    static FILE* out = []{
+        const char* p = getenv("JUS_WATCH_LOG");
+        FILE* f = p ? fopen(p, "a") : nullptr;
+        return f ? f : stderr;
+    }();
+    for (u32 w : watch)
+        if (w >= addr && w < addr + (u32)size) {
+            fprintf(out, "[JUSWATCH] w%-2d addr=%08X val=%08X pc=%08X lr=%08X\n",
+                    size * 8, addr, val, R[15], R[14]);
+            fflush(out);
+        }
+}
